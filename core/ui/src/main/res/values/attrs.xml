<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="TranslateView">
        <attr name="hint" format="string"/>
    </declare-styleable>

    <declare-styleable name="ChooseLanguageView">
        <attr name="fromLanguageText" format="string"/>
        <attr name="toLanguageText" format="string"/>
        <attr name="middleDrawable" format="reference"/>
    </declare-styleable>

    <declare-styleable name="LabeledIconView">
        <attr name="labelText" format="string"/>
        <attr name="trailingText" format="string"/>
        <attr name="trailingIcon" format="integer"/>
        <attr name="customBackgroundColor" format="integer"/>
        <attr name="customLabelColor" format="integer"/>
        <attr name="isShowSwitch" format="boolean"/>
    </declare-styleable>

    <declare-styleable name="CustomToolbarView">
        <attr name="headerIcon" format="integer"/>
        <attr name="headerText" format="string"/>
        <attr name="title" format="string"/>
    </declare-styleable>

</resources>