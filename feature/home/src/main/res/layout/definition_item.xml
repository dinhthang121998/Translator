<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingHorizontal="@dimen/size_8"
    android:paddingStart="@dimen/size_8">

    <TextView
        android:id="@+id/tvDefinition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_8"
        android:layout_marginTop="@dimen/size_8"
        android:text="@string/meaning"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvExample"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_8"
        android:layout_marginTop="@dimen/size_8"
        android:text="@string/example"
        android:textColor="@color/gray_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDefinition" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cAntonym"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_8"
        android:layout_marginTop="@dimen/size_8"
        app:layout_constraintTop_toBottomOf="@+id/tvExample"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/antonymTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/antonym_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvAntonym"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/antonyms"
            android:layout_marginStart="@dimen/size_8"
            app:layout_constraintStart_toEndOf="@+id/antonymTitle"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cSynonym"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_8"
        android:layout_marginTop="@dimen/size_8"
        app:layout_constraintTop_toBottomOf="@+id/cAntonym"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/synonymsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/synonyms_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSynonyms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/synonyms"
            android:layout_marginStart="@dimen/size_8"
            app:layout_constraintStart_toEndOf="@+id/synonymsTitle"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>